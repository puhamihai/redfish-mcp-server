# Path to multi-host config.json. If unset, the server looks for:
#   1. ./config.json                                 (cwd)
#   2. ~/.redfish-mcp-server/config.json
#   3. ~/.config/redfish-mcp-server/config.json
REDFISH_MCP_CONFIG=/path/to/config.json

# Single-host overrides (skip config.json entirely if set):
# REDFISH_HOST=192.0.2.10
# REDFISH_USERNAME=root
# REDFISH_PASSWORD=secret
# REDFISH_VERIFY_SSL=false
